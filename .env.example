# Discord application / command registration
DISCORD_APPLICATION_ID=
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=

# Gateway process
WORKER_INTERNAL_URL=https://replace-me.workers.dev
INTERNAL_SHARED_SECRET=
# In-house LLM (OpenAI-compatible Chat Completions). Leave empty to disable.
LLM_API_URL=http://your-llm-host:1234/v1/chat/completions
LLM_MODEL=your-model-id
LLM_API_KEY=
# Shared bounded controller. One of the model's two sessions is reserved for
# interactive work, so slow background analysis cannot block a mention.
LLM_MAX_CONCURRENCY=2
LLM_MAX_BACKGROUND_CONCURRENCY=1
LLM_MAX_QUEUE=50
LLM_MAX_ATTEMPTS=2
LLM_ATTEMPT_TIMEOUT_SECONDS=45
LLM_TOTAL_TIMEOUT_SECONDS=90
# Scheduled prose gets a larger bounded window because local reasoning latency
# can exceed the generic limit without indicating that the model is down.
BACKGROUND_LLM_ATTEMPT_TIMEOUT_SECONDS=120
BACKGROUND_LLM_TOTAL_TIMEOUT_SECONDS=180
LLM_RETRY_DELAY_SECONDS=2
LLM_CIRCUIT_FAILURES=1
LLM_CIRCUIT_COOLDOWN_SECONDS=60
# A healthy-state synthetic probe is advisory until this many probes fail in a
# row. One successful probe resets the count.
LLM_HEALTH_PROBE_FAILURE_THRESHOLD=3
# Mentions are durable normal Discord messages, not expiring interactions. A
# progress notice is posted while generation continues, then edited in place.
MENTION_LLM_ATTEMPT_TIMEOUT_SECONDS=180
MENTION_LLM_TOTAL_TIMEOUT_SECONDS=240
MENTION_WAIT_NOTICE_SECONDS=15
MENTION_DEFERRED_RETRIES=2
MENTION_RETRY_DELAY_SECONDS=60
JOB_POLL_SECONDS=3
PITCHEEE_URL=
MONITORED_CHANNEL_IDS=
ENABLE_MESSAGE_CONTENT_INTENT=false
PASSIVE_OBSERVE=false
ALLOW_MENTIONS_ANYWHERE=false
WARDEN_ALERT_CHANNEL_ID=
# Channel where スー greets new members and answers replies/mentions (needs Server Members Intent). Empty = off.
WELCOME_CHANNEL_ID=
# Operator channel (店長室) and musings channel (スーの独り言). Empty = resolve by name / create.
OPS_CHANNEL_ID=
MUSINGS_CHANNEL_ID=
OPS_CHANNEL_NAME=店長室
MUSINGS_CHANNEL_NAME=スーの独り言
MUSINGS_HOURS_JST=7,12,18,23
MUSE_ON_START=false
# Nightly maintenance hour (JST). No daily report is produced; operational counts go to the
# Worker log only. DIGEST_HOUR_JST is still read as a fallback for existing deployments.
MAINTENANCE_HOUR_JST=3
DIGEST_HOUR_JST=3

# Local experience notes use the same persistent directory and 30-day maximum as operational logs.
# Single active Gateway per state directory. Empty = default ~/.local/state/su-gateway.
# SU_STATE_DIR=/persistent/su-gateway
# Explicit source-channel allowlist. Empty disables DecisionGarden Knowledge sync.
# The Gateway rechecks bot readership and live source evidence; Garden nodes stay private.
EXPERIENCE_KNOWLEDGE_CHANNEL_IDS=
# Deprecated alias; also syncs private Knowledge only.
EXPERIENCE_PUBLIC_CHANNEL_IDS=
# How often human edits made in DecisionGarden are read back for already-known experience threads.
EXPERIENCE_PULL_SECONDS=3600

# Public connpass API v2 material for conversation and musings.
# Keep this key secret. It is sent only to the fixed connpass API endpoint for subdomain=aid.
CONNPASS_API_KEY=
CONNPASS_ENABLED=false
CONNPASS_POLL_SECONDS=3600
CONNPASS_CACHE_HOURS=24
CONNPASS_DAILY_LIMIT=1

# Daily AI quiz / collective-intelligence poll.
# QUIZ_CHANNEL_ID falls back to MUSINGS_CHANNEL_ID when empty.
QUIZ_ENABLED=true
QUIZ_CHANNEL_ID=
QUIZ_HOUR_JST=20
# Set true temporarily to post one immediately after the gateway starts.
QUIZ_ON_START=false
# Google News RSS query used as the daily material.
QUIZ_NEWS_QUERY=AI OR OpenAI OR Anthropic OR Claude OR Gemini OR LLM when:1d
# Optional community-only prediction seeds, separated by |.
# Example: Tiboが次にGPTをresetするのはいつ？|次にコミュニティで流行るAI開発ツールは？
QUIZ_COMMUNITY_PROMPTS=

# nexa.host.update.readiness/v1 on loopback
READINESS_PORT=8791
GATEWAY_HOST_LABEL=gateway-202
GATEWAY_DEBUG=0
WARDEN_WINDOW_SECONDS=30
WARDEN_MAX_MESSAGES=5
WARDEN_COOLDOWN_SECONDS=300
