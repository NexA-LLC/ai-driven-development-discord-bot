# Discord application / command registration
DISCORD_APPLICATION_ID=
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=

# Gateway process
WORKER_INTERNAL_URL=https://replace-me.workers.dev
INTERNAL_SHARED_SECRET=
# In-house LLM (OpenAI-compatible Chat Completions). Leave empty to disable.
LLM_API_URL=http://your-llm-host:1234/v1/chat/completions
LLM_MODEL=your-model-id
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=120
JOB_POLL_SECONDS=3
PITCHEEE_URL=
MONITORED_CHANNEL_IDS=
ENABLE_MESSAGE_CONTENT_INTENT=false
PASSIVE_OBSERVE=false
ALLOW_MENTIONS_ANYWHERE=false
WARDEN_ALERT_CHANNEL_ID=
# Channel where スー greets new members (needs Server Members Intent). Empty = off.
WELCOME_CHANNEL_ID=
# Operator channel (店長室) and musings channel (スーの独り言). Empty = resolve by name / create.
OPS_CHANNEL_ID=
MUSINGS_CHANNEL_ID=
OPS_CHANNEL_NAME=店長室
MUSINGS_CHANNEL_NAME=スーの独り言
MUSINGS_HOUR_JST=23
DIGEST_HOUR_JST=3
# nexa.host.update.readiness/v1 on loopback
READINESS_PORT=8791
GATEWAY_HOST_LABEL=gateway-202
GATEWAY_DEBUG=0
WARDEN_WINDOW_SECONDS=30
WARDEN_MAX_MESSAGES=5
WARDEN_COOLDOWN_SECONDS=300
