{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ai-driven-development-discord-bot",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "vars": {
    "COMMUNITY_NAME": "AI Driven Development",
    "DISCORD_APPLICATION_ID": "1546091192444260442",
    "AI_PROVIDER": "gateway",
    "AI_API_URL": "",
    "AI_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
    "PITCHEEE_URL": "",
    "OPS_CHANNEL_ID": "1546347217705639987",
    "MUSINGS_CHANNEL_ID": "1546347219244818482",
    "GITHUB_REPO": "NexA-LLC/ai-driven-development-discord-bot",
    "CASEFLOW_MCP_URL": "https://caseflow.nex-a.net/api/mcp?tenantId=nexa",
    "CASEFLOW_PROJECT_ID": "01a07746-6221-7b69-a50b-f1e53ae72a9a",
    "DECISIONGARDEN_MCP_URL": "https://decisiongarden.nex-a.net/api/mcp",
    "DECISIONGARDEN_GARDEN_ID": "01a07678-baa8-7d55-8463-f11944a2b0f8"
  },
  "ai": {
    "binding": "AI"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ai-driven-development-discord",
      "database_id": "4a96b6b2-265b-472d-8ddd-220bf390f9bd",
      "migrations_dir": "migrations"
    }
  ]
}
