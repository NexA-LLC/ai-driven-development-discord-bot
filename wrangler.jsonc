{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ai-driven-development-discord-bot",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "vars": {
    "COMMUNITY_NAME": "AI Driven Development",
    "DISCORD_APPLICATION_ID": "1546091192444260442",
    "AI_PROVIDER": "gateway",
    "AI_API_URL": "",
    "AI_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
    "PITCHEEE_URL": ""
  },
  "ai": {
    "binding": "AI"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ai-driven-development-discord",
      "database_id": "4a96b6b2-265b-472d-8ddd-220bf390f9bd",
      "migrations_dir": "migrations"
    }
  ]
}
